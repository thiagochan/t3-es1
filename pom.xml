<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- O pai do Spring Boot só fornece as versões das bibliotecas (H2, HikariCP, Jackson, JUnit...).
	     Apenas o módulo MyEnderecoServicos usa o Spring de fato. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>unioeste</groupId>
	<artifactId>t3-es1</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>t3-es1</name>
	<description>T3 - Engenharia de Software I: serviços de Endereço (T3B) e classes de negócio do IR (T3A)</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<properties>
		<java.version>17</java.version>
	</properties>

	<!-- Ordem de dependência: BO -> Infra -> ServicosImpl -> Servicos / Teste -->
	<modules>
		<module>MyEnderecoBO</module>
		<module>MyPessoaBO</module>
		<module>MyImpostoRendaBO</module>
		<module>MyInfraAPI</module>
		<module>MyEnderecoServicosImpl</module>
		<module>MyEnderecoServicos</module>
		<module>MyEnderecoTeste</module>
	</modules>

	<!-- Versão única dos módulos internos, para os poms dos módulos não repetirem a versão -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>unioeste</groupId>
				<artifactId>MyEnderecoBO</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>unioeste</groupId>
				<artifactId>MyPessoaBO</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>unioeste</groupId>
				<artifactId>MyImpostoRendaBO</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>unioeste</groupId>
				<artifactId>MyInfraAPI</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>unioeste</groupId>
				<artifactId>MyEnderecoServicosImpl</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
